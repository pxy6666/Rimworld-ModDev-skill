      "phase": "takeoff",
      "logical_xz": [1, 2],
      "visual_offset_xz": [0, 1],
      "layer": "low-flight",
      "shader": "Fixture/Flying",
      "expected": {
        "draw_xz": [1, 3],
        "screen_xy": [4, -12],
        "sprite_top_left_xy": [2, -13],
        "screen_delta_xy": [0, -4],
        "layer": "low-flight",
        "altitude_y": 3,
        "back_to_front": ["pawn", "drone", "building"],
        "shader": "Fixture/Flying"
      }
    },
    {
      "phase": "cruise",
      "logical_xz": [3, 2],
      "visual_offset_xz": [0, 3],
      "layer": "high-flight",
      "shader": "Fixture/Flying",
      "expected": {
        "draw_xz": [3, 5],
        "screen_xy": [12, -20],
        "sprite_top_left_xy": [10, -21],
        "screen_delta_xy": [0, -12],
        "layer": "high-flight",
        "altitude_y": 8,
        "back_to_front": ["pawn", "building", "drone"],
        "shader": "Fixture/Flying"
      }
    },
    {
      "phase": "descent",
      "logical_xz": [5, 2],
      "visual_offset_xz": [0, 1],
      "layer": "low-flight",
      "shader": "Fixture/Flying",
      "expected": {
        "draw_xz": [5, 3],
        "screen_xy": [20, -12],
        "sprite_top_left_xy": [18, -13],
        "screen_delta_xy": [0, -4],
        "layer": "low-flight",
        "altitude_y": 3,
        "back_to_front": ["pawn", "drone", "building"],
        "shader": "Fixture/Flying"
      }
    }
  ],
  "cruise_controls": [
    {
      "name": "altitude-only",
      "replace": {"layer": "low-flight"},
      "expected_changes": {
        "layer": "low-flight",
        "altitude_y": 3,
        "back_to_front": ["pawn", "drone", "building"]
      }
    },
    {
      "name": "no-visible-lift-at-high-altitude",
